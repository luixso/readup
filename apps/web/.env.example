# Cuentas y sincronización (opcional). Sin estas variables la app funciona solo en local.
# Supabase → Project Settings → API (o "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# (o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_..., nombre que puede crear la integración de Vercel)
# Proveedores OAuth activados en Supabase (opcional): github,google
NEXT_PUBLIC_AUTH_PROVIDERS=
